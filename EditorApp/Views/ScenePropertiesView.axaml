<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EditorApp.ViewModels"
             x:Class="EditorApp.Views.ScenePropertiesView"
             x:CompileBindings="False">
    <ScrollViewer>
        <StackPanel Margin="6">

            <Expander Header="Background Color" IsExpanded="True">
                <Grid ColumnDefinitions="20,*" RowDefinitions="Auto,Auto,Auto,Auto"
                      Margin="4">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="R" VerticalAlignment="Center" Margin="0,2,6,2"/>
                    <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding BgR, Mode=TwoWay}" Minimum="0" Maximum="1" Increment="0.01" FormatString="F2"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="G" VerticalAlignment="Center" Margin="0,2,6,2"/>
                    <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding BgG, Mode=TwoWay}" Minimum="0" Maximum="1" Increment="0.01" FormatString="F2"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="B" VerticalAlignment="Center" Margin="0,2,6,2"/>
                    <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding BgB, Mode=TwoWay}" Minimum="0" Maximum="1" Increment="0.01" FormatString="F2"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="A" VerticalAlignment="Center" Margin="0,2,6,2"/>
                    <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding BgA, Mode=TwoWay}" Minimum="0" Maximum="1" Increment="0.01" FormatString="F2"/>
                </Grid>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</UserControl>

